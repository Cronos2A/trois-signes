<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune sauvegarde ni copie d'appareil à appareil par Android : la progression vit sur l'appareil et au serveur
     (Firebase) ; seule la liaison Google la protège d'une désinstallation (docs/EMBALLAGE.md). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
