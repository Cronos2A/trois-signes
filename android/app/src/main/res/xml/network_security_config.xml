<?xml version="1.0" encoding="utf-8"?>
<!-- Trafic non chiffré (http://) interdit partout : Firebase et le jeu passent en https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
