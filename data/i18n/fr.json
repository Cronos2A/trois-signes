  "grammar": {
    "of": {
      "note": "« de » + pseudo d'un joueur (ofName, src/i18n.js) : première règle dont l'expression correspond ({rest} : la suite du nom), sinon « default ».",
      "rules": [
        {
          "match": "^Le\\s+(.*)$",
          "out": "du {rest}"
        },
        {
          "match": "^Les\\s+(.*)$",
          "out": "des {rest}"
        },
        {
          "match": "^La\\s+(.*)$",
          "out": "de la {rest}"
        },
        {
          "match": "^L['’]\\s*(.*)$",
          "out": "de l'{rest}"
        },
        {
          "match": "^y[aeiouyàâéèêîôû]",
          "flags": "i",
          "out": "de {name}"
        },
        {
          "match": "^[aeiouyàâäéèêëîïôöùûüœæ]",
          "flags": "i",
          "out": "d'{name}"
        }
      ],
      "default": "de {name}"
    }
  },
