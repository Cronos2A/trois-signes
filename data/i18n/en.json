  "grammar": {
    "of": {
      "note": "Possessive of a player's username (ofName, src/i18n.js): first matching rule, else \"default\". Names ending in s take a bare apostrophe.",
      "rules": [
        {
          "match": "[sS]$",
          "out": "{name}'"
        }
      ],
      "default": "{name}'s"
    }
